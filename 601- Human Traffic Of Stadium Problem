    visit_date = EXCLUDED.visit_date,
    people = EXCLUDED.people;



select *
from visits;



with cte as (select *,
id - row_number() over(order by visit_date) as flag
from visits
where people>=100)


select id, visit_date, people
from
(select *,
count(1) over(partition by flag) as cnt
from cte) t1 
where cnt>=3
