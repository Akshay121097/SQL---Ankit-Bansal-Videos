select * from brands;

with cte as (select  *,
sum(case when category is not null then 1 else 0 end) over(rows between unbounded preceding and current row) as rn
from brands)

select t2.category, t1.brand_name from cte t1 
inner join (select * from cte where category is not null) t2 
on t1.rn = t2.rn
