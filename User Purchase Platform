select *
from spending;




with cte as (select spend_date, user_id
from spending
group by spend_date, user_id
having count(distinct platform)=2)

select t1.spend_date, t1.platform, sum(amount) as total_amount, count(distinct t1.user_id) as total_users
from spending t1 
left join cte t2 
on t1.user_id = t2.user_id and t1.spend_date = t2.spend_date
where t2.spend_date is null
group by 1,2
union all 
select t1.spend_date, 'both' as platform, 
sum(case when t2.spend_date is not null then amount else null end) as total_amount, 
count(distinct case when t2.spend_date is not null then t1.user_id else null end  ) as total_users
from spending t1 
left join cte t2 
on t1.user_id = t2.user_id and t1.spend_date = t2.spend_date
--where t2.spend_date is not null
group by 1,2
