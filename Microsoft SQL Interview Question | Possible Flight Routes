--Connecting flights
select t1.flight_id,t2.flight_id, concat(t1.flight_id,',',t2.flight_id),t3.city_name,
t5.city_name,t4.city_name,
round(EXTRACT(EPOCH FROM (t2.end_time - t1.start_time))/60) as time_taken
from flights t1 
left join flights t2 
on t1.end_port = t2.start_port 
inner join airports t3 
on t1.start_port = t3.port_code and t3.city_name='New York'
inner join airports t4
on t2.end_port = t4.port_code and t4.city_name='Tokyo'
