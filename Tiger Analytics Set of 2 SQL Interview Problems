select * from flights;
select * from  sales;


with cte as (select *,
row_number() over(partition by cid order by fid) as rn_st,
row_number() over(partition by cid order by fid desc ) as rn_fn
from flights)

select cid,
max(case when rn_st=1 then origin else null end) as origin,
max(case when rn_fn=1 then Destination else null end) as Destination
from cte 
group by cid;


with cte1 as (select extract(MONTH from order_date) as date, customer,
min(extract(MONTH from order_date)) over(partition by customer) as rn
from sales)

select date,
count(distinct case when date=rn then customer else null end) as new_customners
from cte1
group by 1
