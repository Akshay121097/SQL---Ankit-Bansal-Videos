with cte as (select *,
sum(salary) over( partition by experience order by  salary) as experience_running_salary
from candidates),

senior_salary as (select *
from cte where experience='Senior' and experience_running_salary<=70000)


select *
from cte
where experience='Junior'
and salary<= (70000- (select sum(salary) from senior_salary))
union all 
select *
from senior_salary
