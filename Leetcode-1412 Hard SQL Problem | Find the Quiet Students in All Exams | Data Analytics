select * from students;


with cte as (select * ,
case when score= min(score) over(partition by exam_id) or score = max(score) over(partition by exam_id) then 'N' else 'Y' end as flag
from exams)


select student_id
from cte 
group by student_id
having count(distinct flag)=1 and min(flag)='Y'
