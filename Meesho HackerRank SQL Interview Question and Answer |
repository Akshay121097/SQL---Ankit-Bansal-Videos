create table products
(
product_id varchar(20) ,
cost int
);
insert into products values ('P1',200),('P2',300),('P3',500),('P4',800);

create table customer_budget
(
customer_id int,
budget int
);

insert into customer_budget values (100,400),(200,800),(300,1500);


select * from products;
select * from customer_budget;




with cte as (select *,
sum(cost) over(rows between unbounded preceding and current row) as rn_tl
from products)


select customer_id, budget, count(distinct product_id) as no_of_products
from
(select customer_id, product_id, budget
from cte
cross join customer_budget
where rn_tl<=budget) t1 
group by 1,2
