select *
from exams;


with cte as (select *,
min(score) over(partition by exam_id) as least_score,
max(score) over(partition by exam_id) as max_score
from exams)

select student_id
from 
(select *,
case when score = least_score or score = max_score then 1 else 0 end as flag
from cte ) t1 
group by 1 
having count(distinct flag) =1 and min(flag)=0



