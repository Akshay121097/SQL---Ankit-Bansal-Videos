create table business_city (
business_date date,
city_id int
);
delete from business_city;
insert into business_city
values(cast('2020-01-02' as date),3),(cast('2020-07-01' as date),7),(cast('2021-01-01' as date),3),(cast('2021-02-03' as date),19)
,(cast('2022-12-01' as date),3),(cast('2022-12-15' as date),3),(cast('2022-02-28' as date),12);



with cte as (select *,extract(year from business_date) as year_number,
case when business_date=min(business_date) over(partition by city_id ) then 'New' else 'Old' end as flag
from business_city)



select year_number,
sum(case when flag='New' then 1 else 0 end) as new_buisness
from cte 
group by year_number
order by 1
