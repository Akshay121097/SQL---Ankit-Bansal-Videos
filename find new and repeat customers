select *
from customer_orders;


with cte as (select t1.*,
case when t2.first_date is null then 'Old' else 'New' end as flag
from customer_orders t1
left join 
(select customer_id, min(order_date) as first_date
from customer_orders
group by 1) t2
on t1.customer_id = t2.customer_id and t1.order_date = t2.first_date)

select order_date,
sum(case when flag='New' then 1 else 0 end) as new_customers,
sum(case when flag='Old' then 1 else 0 end) as old_customers
from cte
group by order_date
order by order_date
