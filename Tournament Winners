select * from players;

select * from matches;


with player_data as (select match_id, first_player as player , first_score as score 
from matches
union all 
select match_id, second_player as player , second_score as score 
from matches),

rank_data as (select t1.*, t2.group_id,
dense_rank() over(partition by group_id order by score desc ,player ) as rn
from player_data t1 
inner join players t2 
on t1.player = t2.player_id)

select group_id, player, score
from rank_data
where rn=1;
