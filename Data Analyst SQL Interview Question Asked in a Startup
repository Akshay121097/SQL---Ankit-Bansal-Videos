select *
from call_start_logs;

select *
from call_end_logs;

with call_end_logs_rn as 
(
select *,
row_number() over(partition by phone_number order by end_time) as end_rn
from call_end_logs
),
call_start_logs_rn as 
(
select *,
row_number() over(partition by phone_number order by start_time) as start_rn
from call_start_logs
)


select t1.phone_number, t1.start_time, t2.end_time
from call_start_logs_rn t1
inner join call_end_logs_rn  t2
on t1.phone_number = t2.phone_number and t1.start_rn = t2.end_rn
