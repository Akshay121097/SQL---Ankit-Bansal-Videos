create table company_revenue 
(
company varchar(100),
year int,
revenue int
);

insert into company_revenue values 
('ABC1',2000,100),('ABC1',2001,110),('ABC1',2002,120),('ABC2',2000,100),('ABC2',2001,90),('ABC2',2002,120)
,('ABC3',2000,500),('ABC3',2001,400),('ABC3',2002,600),('ABC3',2003,800);


with cte as  (select *,
row_number() over(partition by company order by year) as yr_rn,
row_number() over(partition by company order by revenue) as revenue_rn
from company_revenue)

select company
from cte
group by 1 
having count(distinct (revenue_rn- yr_rn))=1 and sum(revenue_rn- yr_rn)=0 
