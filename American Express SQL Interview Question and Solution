--select * from likes;


with cte as (select distinct f.user_id, l2.page_id
--f.*, l1.page_id as user_page_like , l2.page_id as friend_page_like
from friends f 
inner join likes l1 
on f.user_id = l1.user_id
inner join likes l2 
on f.friend_id = l2.user_id
where l1.page_id <> l2.page_id
)


select cte.*
from likes 
right join cte 
on likes.user_id = cte.user_id and likes.page_id = cte.page_id
where likes.user_id is null;
