select *
from city_population;

with cte as (select *,
row_number() over(partition by state order by population ) as min_pop,
row_number() over(partition by state order by population  desc) as max_pop
from city_population)

select state,
max(case when max_pop=1 then city else null end ) as max_population,
max(case when min_pop=1 then city else null end ) as min_population
from cte
group by 1;
