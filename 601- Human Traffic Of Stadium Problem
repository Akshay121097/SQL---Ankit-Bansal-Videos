-- Step 1: Create the Visits table
CREATE TABLE IF NOT EXISTS Visits (
    id INTEGER PRIMARY KEY,
    visit_date DATE NOT NULL,
    people INTEGER NOT NULL
);

-- Step 2: Insert the data with UPSERT logic
